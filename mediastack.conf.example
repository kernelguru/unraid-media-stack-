# Kopieren nach "mediastack.conf" (neben mediastack.sh) und anpassen.
# Alles, was hier nicht steht, nimmt die Standardwerte aus dem Script.

# Plattform: auto | unraid | debian
#PLATFORM="auto"

#SERVER_IP="192.168.1.10"           # leer = automatisch erkennen
#TZ="Europe/Berlin"
# Leer lassen = Standard der Plattform (siehe README → Plattformen)
#PUID=""
#PGID=""
#APPDATA=""                          # Unraid: /mnt/user/appdata · Debian: /opt/mediastack
#DATA=""                             # Unraid: /mnt/user/data    · Debian: /srv
#MOUNT_HOST=""                       # Unraid: /mnt/addons/nzbdav · Debian: /mnt/nzbdav

# Debian/Ubuntu: Docker aus dem offiziellen Repository installieren
#INSTALL_DOCKER=true

# Jellyfin Hardware-Beschleunigung: auto | none | qsv | vaapi | nvenc
#JELLYFIN_HWACCEL="auto"
#JELLYFIN_HWACCEL_FORCE=false

#ADMIN_USER="admin"
#ADMIN_PASS=""                       # leer = wird beim Start abgefragt
#ADMIN_EMAIL="admin@mediastack.local"

# Zusätzliche "Allowed Hosts" für Radarr/Sonarr/Prowlarr (Adressen, unter denen
# du sie aufrufst – z. B. Reverse-Proxy-Domains). Server-IP/Hostname sind automatisch drin.
#ARR_ALLOWED_HOSTS="radarr.example.com,*.example.com"

# Dashboard mit Links, API-Keys und Status (ohne Login – nur im LAN!)
#DASHBOARD_ENABLED=true
#P_DASHBOARD=8090

#LANG_CODE="de"
#COUNTRY_CODE="DE"

#CAT_MOVIES="movies"
#CAT_TV="tv"
#RCLONE_CACHE_SIZE="50G"
#RCLONE_CACHE_MAX_AGE="1w"
#RCLONE_READ_AHEAD="512M"
#RCLONE_RC=false          # erst true, wenn InfiniDysk die RC-Daten kennt (README)
#P_WEBDAV=18080           # Host-Port für den InfiniDysk-Backend-Port 8080

# rclone: leer = Standard (Unraid: plugin · Debian: systemd) | plugin | systemd | container
#RCLONE_MODE=""
#RCLONE_REMOTE="nzbdav"

# Image von InfiniDysk – bitte prüfen/anpassen
#IMG_INFINIDYSK="ghcr.io/infinidysk/infinidysk:latest"

# Ports
#P_INFINIDYSK=3000
#P_PROWLARR=9696
#P_RADARR=7878
#P_SONARR=8989
#P_JELLYFIN=8096
#P_SEERR=5055

# TRaSH-Guides per Recyclarr
#RECYCLARR_ENABLED=true
# german-hd-bluray-web | german-hd-remux-web | german-uhd-bluray-web |
# german-uhd-bluray-web-alternative | german-uhd-remux-web | german-anime-hd-bluray-web
#TRASH_PROFILES=(german-hd-bluray-web german-uhd-bluray-web)   # erstes = Haupt-Profil
#TRASH_ANY_GERMAN=true          # eigenes Profil "[German] Any" (nur deutsch, Upgrades bis 1080p)
#SEERR_PROFILE="[German] HD Bluray + WEB"
#RECYCLARR_SCHEDULE="@daily"
#SEERR_USE_TRASH_PROFILE=true

# Zusätzliche Volumes ("host:container[:optionen]")
# Nach einer Änderung: bash mediastack.sh update
# Verfügbar: JELLYFIN_, RADARR_, SONARR_, PROWLARR_, SEERR_, INFINIDYSK_,
#            RCLONE_NZBDAV_EXTRA_VOLUMES
#JELLYFIN_EXTRA_VOLUMES=(
#  "/mnt/user/Fotos:/data/fotos:ro"
#  "/mnt/user/Musik:/data/musik:ro"
#)
#RADARR_EXTRA_VOLUMES=()
#SONARR_EXTRA_VOLUMES=()

# Usenet-Indexer automatisch in Prowlarr anlegen
# Format: "Name|https://indexer.tld|APIKEY"
#INDEXERS=(
#  "NZBgeek|https://api.nzbgeek.info|DEIN_API_KEY"
#)
